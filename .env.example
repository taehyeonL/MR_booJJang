# Mobile app: only publishable Supabase values may be exposed to the app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://hbkqehvrgbnkfthsfppk.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
EXPO_PUBLIC_SERVICE_PHONE_NUMBER=+821012345678

# Supabase Edge Function secrets: configure with `supabase secrets set`, never commit.
SUPABASE_URL=https://hbkqehvrgbnkfthsfppk.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Voice provider: start with `mock`; use `twilio` only after a verified account/number exists.
VOICE_PROVIDER=mock
VOICE_ACCOUNT_ID=replace_me
VOICE_AUTH_TOKEN=replace_me
VOICE_FROM_NUMBER=+821012345678
VOICE_WEBHOOK_SECRET=replace_me

# AI voice provider: server-only secret.
AI_PROVIDER_API_KEY=replace_me

# Operations
APP_BASE_URL=https://your-app.example.com
DEFAULT_TIMEZONE=Asia/Seoul
RINGING_TIMEOUT_SECONDS=30
MAX_RETRY_ATTEMPTS=3
SCHEDULER_SECRET=replace_me
